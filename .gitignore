deploy/docker/runtime/
deploy/docker/.env
deploy/docker/.env.bak.*

# --- Android signing ---
mobile_app/android/key.properties
mobile_app/android/app/*.jks
mobile_app/android/app/*.keystore

# --- OS / editor ---
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
.~lock*

