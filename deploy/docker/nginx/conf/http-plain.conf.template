# HTTP-only vhost (NGINX_TLS=0): serves API, SSE, OTA, panel and the web app on :80.

server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Live SSE: disable proxy buffering so frames stream through immediately.
    location /api/v1/stream {
        proxy_pass http://${UPSTREAM_SERVER}:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_read_timeout 1h;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no;
        add_header Cache-Control "no-cache, no-transform" always;
        add_header Access-Control-Allow-Origin "http://${NGINX_DOMAIN}" always;
    }

    location /api/ {
        proxy_pass http://${UPSTREAM_SERVER}:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "http://${NGINX_DOMAIN}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /panel {
        return 301 /panel/;
    }

    location /panel/ {
        proxy_pass http://${UPSTREAM_SERVER}:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /fw/ {
        alias /usr/share/nginx/html/fw/;
    }

    location /app/ {
        try_files $uri $uri/ /app/index.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
