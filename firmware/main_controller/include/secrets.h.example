// ============================================================================
// secrets.h — build-time secret overrides for the main controller.
//
// Copy this file to "secrets.h" in the SAME directory and put the REAL
// credentials there. This example ships with empty placeholders and is NOT
// meant to be compiled: without a real secrets.h the defaults in config.h are
// empty, so MQTT auth and registry calls fail safe instead of shipping a
// credential. Non-secret settings (broker host, device id, ports) stay in
// config.h.
//
//     cp include/secrets.h.example include/secrets.h
//
// WARNING: this file is git-ignored. Never commit the real values, never
// rename it to something tracked. For public OTA builds use
// -DAERIS_NO_COMPILED_SECRETS (see deploy/build_fw_release.ps1).
//
// Every macro below is optional — define only what must be rotated.
// ============================================================================
#ifndef SECRETS_H
#define SECRETS_H

// --- MQTT broker credentials (VPS Mosquitto) ---
// The same login is used for the registry API over HTTP Basic.
//#define MQTT_USER     "device"
//#define MQTT_PASSWORD "generate a strong value, e.g. openssl rand -hex 16"

// --- First-boot SoftAP password (optional) ---
//#define PROVISION_AP_PASSWORD ""

// Priority at runtime: NVS ("secrets" namespace) > secrets.h > config.h.
// The SoftAP provisioning page writes the MQTT user/password into NVS.
// Values defined here are migrated into NVS on first boot, so they keep
// working after an OTA to a release build without compiled secrets.
//
// Release builds published to /fw must be produced with
// -DAERIS_NO_COMPILED_SECRETS so this file is ignored entirely.

#endif // SECRETS_H